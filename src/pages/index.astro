---
import BaseLayout from '../layouts/BaseLayout.astro';
import AppStoreBadge from '../components/AppStoreBadge.astro';
import NewsletterForm from '../components/NewsletterForm.astro';
import OnDeviceAI from '../components/OnDeviceAI.astro';

const showcases = [
	{
		tag: 'Sleep stages',
		title: 'See every stage of your night',
		body: 'A clear timeline of Awake, REM, Light, and Deep — alongside your sleep score, time asleep, and efficiency. Understand your nightly patterns and wake up refreshed.',
		image: '/img/track-stages.jpg',
		alt: 'Sleepr sleep-stages overview showing sleep score, time asleep, efficiency, and a stage timeline',
		reverse: false,
	},
	{
		tag: 'Sleep recordings',
		title: 'Hear what happens while you sleep',
		body: 'Sleepr listens on-device and surfaces the moments that matter — snore clips, sleep talking, and quiet nights. Replay the night events and discover what you never knew.',
		image: '/img/snoring.jpg',
		alt: 'Sleepr sleep-recordings panel with snore time, longest snore, and replayable night events',
		reverse: true,
	},
	{
		tag: 'Daily routine',
		title: 'Build better habits, one night at a time',
		body: 'Small, science-backed habits add up. Track caffeine cut-offs, morning sunlight, screen-free wind-downs, and a consistent bedtime — then watch your streak grow.',
		image: '/img/routine.jpg',
		alt: 'Sleepr daily routine checklist of sleep habits with progress',
		reverse: false,
	},
	{
		tag: 'Smart alarm',
		title: 'Wake up at the right moment',
		body: 'Set a smart wake window and Sleepr nudges you awake during a lighter phase of your cycle — so mornings feel gentle instead of jarring.',
		image: '/img/smart-alarm.jpg',
		alt: 'Sleepr smart alarm screen with a wake-window slider and time picker',
		reverse: true,
	},
];

const features = [
	{
		title: 'Private by design',
		body: 'On-device microphone analysis. Audio is processed in real time on your iPhone and never uploaded to any server.',
	},
	{
		title: 'Smart event detection',
		body: 'Detects snoring, talking, coughs, and movement throughout the night — without sending audio anywhere.',
	},
	{
		title: 'Somnus, your AI sleep coach',
		body: 'Chat with an AI coach that understands your patterns and helps you build better habits, night after night.',
	},
	{
		title: 'Trends, streaks & friends',
		body: 'Watch sleep trends across weeks, months, and years. Climb leagues with friends as your streak grows.',
	},
];
---

<BaseLayout title="Sleepr — privacy-first AI sleep tracking">
	<section class="hero container">
		<div class="hero-copy reveal">
			<p class="eyebrow">For iPhone · Private by design</p>
			<h1 class="display">
				Sleep better.<br />
				<span class="accent">Privately.</span>
			</h1>
			<p class="lead">
				Sleepr analyses your sleep on-device with AI. Your audio never leaves
				your phone — and you wake up with a clearer picture of how you slept.
			</p>
			<div class="cta-row">
				<AppStoreBadge size="lg" />
				<a class="secondary" href="#features">See what it does ↓</a>
			</div>
			<ul class="hero-trust">
				<li>On-device AI</li>
				<li>No audio uploads</li>
				<li>Free to download</li>
			</ul>
		</div>

		<div class="hero-art reveal" style="--reveal-delay: 120ms">
			<div class="phone-glow" aria-hidden="true"></div>
			<img
				class="phone phone-float"
				src="/img/phone-overview.png"
				alt="Sleepr app open on an iPhone, showing the sleep overview with sleep score and stage graph"
				width="500"
				height="750"
				fetchpriority="high"
			/>
		</div>
	</section>

	<section class="showcases container" id="features">
		{
			showcases.map(({ tag, title, body, image, alt, reverse }) => (
				<article class={`showcase reveal ${reverse ? 'is-reverse' : ''}`}>
					<div class="showcase-art">
						<div class="frame-glow" aria-hidden="true" />
						<img
							class="frame"
							src={image}
							alt={alt}
							width="500"
							height="700"
							loading="lazy"
						/>
					</div>
					<div class="showcase-copy">
						<p class="usp-tag">{tag}</p>
						<h2 class="display">{title}</h2>
						<p>{body}</p>
					</div>
				</article>
			))
		}
	</section>

	<OnDeviceAI />

	<section class="usp container reveal">
		<div class="usp-band">
			<p class="usp-tag">The Sleepr difference</p>
			<h2 class="display">
				Your microphone stays
				<span class="accent">on your phone.</span>
			</h2>
			<p class="usp-body">
				Most sleep apps upload your audio for analysis. Sleepr doesn't. Every
				snore, cough, and movement is processed in real time on-device — there is
				no audio recording to upload, leak, or subpoena. The only thing leaving
				your phone is the sleep summary you choose to sync.
			</p>
		</div>
	</section>

	<section class="features container">
		<h2 class="section-title display reveal">Built for better nights</h2>
		<div class="grid">
			{
				features.map(({ title, body }, i) => (
					<article class="card reveal" style={`--reveal-delay: ${i * 80}ms`}>
						<h3>{title}</h3>
						<p>{body}</p>
					</article>
				))
			}
		</div>
	</section>

	<section class="signup container reveal">
		<NewsletterForm />
	</section>

	<section class="download container">
		<div class="download-inner reveal">
			<div class="download-copy">
				<h2 class="display">Ready to sleep better?</h2>
				<p>
					Free to download. Sleepr Pro unlocks the AI coach and advanced
					trends.
				</p>
				<AppStoreBadge size="lg" />
			</div>
			<div class="download-art" aria-hidden="true">
				<div class="phone-glow"></div>
				<img
					class="phone phone-float"
					src="/img/phone-stats.png"
					alt=""
					width="420"
					height="525"
					loading="lazy"
				/>
			</div>
		</div>
	</section>
</BaseLayout>

<style>
	/* ---------- Hero ---------- */
	.hero {
		display: grid;
		gap: var(--space-8);
		padding-block: var(--space-12) var(--space-10);
	}

	@media (min-width: 900px) {
		.hero {
			grid-template-columns: 1.05fr 0.95fr;
			align-items: center;
			gap: var(--space-10);
			padding-block: var(--space-16) var(--space-12);
		}
	}

	.eyebrow {
		margin: 0 0 var(--space-4);
		font-size: var(--text-sm);
		font-weight: 600;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--color-accent-bright);
	}

	.hero h1 {
		font-size: clamp(3rem, 8vw, 5.25rem);
		margin-bottom: var(--space-5);
	}

	.accent {
		background: linear-gradient(
			135deg,
			var(--color-accent-bright),
			var(--color-accent)
		);
		-webkit-background-clip: text;
		background-clip: text;
		color: transparent;
	}

	.lead {
		font-size: var(--text-lg);
		max-width: 36rem;
		color: var(--color-text-muted);
		margin-bottom: var(--space-6);
	}

	.cta-row {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: var(--space-5);
	}

	.secondary {
		font-weight: 500;
		color: var(--color-text-muted);
	}

	.secondary:hover,
	.secondary:focus-visible {
		color: var(--color-text-primary);
	}

	.hero-trust {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2) var(--space-5);
		margin: var(--space-6) 0 0;
		padding: 0;
		list-style: none;
	}

	.hero-trust li {
		position: relative;
		padding-left: var(--space-4);
		font-size: var(--text-sm);
		color: var(--color-text-muted);
	}

	.hero-trust li::before {
		content: '';
		position: absolute;
		left: 0;
		top: 50%;
		transform: translateY(-50%);
		width: 6px;
		height: 6px;
		border-radius: 50%;
		background: var(--color-teal);
		box-shadow: 0 0 8px var(--color-teal);
	}

	/* ---------- Phone art ---------- */
	.hero-art,
	.download-art {
		position: relative;
		display: grid;
		place-items: center;
	}

	.phone {
		position: relative;
		z-index: 1;
		width: clamp(240px, 34vw, 380px);
		height: auto;
		filter: drop-shadow(0 40px 70px rgba(0, 0, 0, 0.55));
	}

	.phone-glow {
		position: absolute;
		inset: 0;
		z-index: 0;
		background: radial-gradient(
			circle at 50% 45%,
			rgba(124, 107, 173, 0.5) 0%,
			rgba(124, 107, 173, 0.18) 35%,
			transparent 68%
		);
		filter: blur(20px);
	}

	.phone-float {
		animation: float 7s ease-in-out infinite;
	}

	@keyframes float {
		0%,
		100% {
			transform: translateY(0);
		}
		50% {
			transform: translateY(-14px);
		}
	}

	/* ---------- Showcase rows ---------- */
	.showcases {
		display: grid;
		gap: var(--space-12);
		padding-block: var(--space-12);
	}

	.showcase {
		display: grid;
		gap: var(--space-8);
		align-items: center;
	}

	@media (min-width: 860px) {
		.showcase {
			grid-template-columns: 1fr 1fr;
			gap: var(--space-10);
		}
		.showcase.is-reverse .showcase-art {
			order: 2;
		}
	}

	.showcase-art {
		position: relative;
		display: grid;
		place-items: center;
	}

	.frame {
		position: relative;
		z-index: 1;
		width: min(100%, 440px);
		height: auto;
		border-radius: var(--radius-xl);
		border: 1px solid var(--glass-border);
		box-shadow: var(--shadow-float);
		transform: perspective(1200px) rotateY(4deg);
		transition: transform 500ms var(--ease-out);
	}

	.showcase.is-reverse .frame {
		transform: perspective(1200px) rotateY(-4deg);
	}

	.showcase-art:hover .frame {
		transform: perspective(1200px) rotateY(0deg) translateY(-6px);
	}

	.frame-glow {
		position: absolute;
		inset: 8% 12%;
		z-index: 0;
		background: radial-gradient(
			circle at 50% 40%,
			rgba(124, 107, 173, 0.45),
			transparent 70%
		);
		filter: blur(36px);
	}

	.showcase-copy h2 {
		font-size: clamp(1.9rem, 4vw, 2.85rem);
		margin-bottom: var(--space-4);
	}

	.showcase-copy p {
		font-size: var(--text-lg);
		color: var(--color-text-muted);
		margin: 0;
		max-width: 34rem;
	}

	.usp-tag {
		margin: 0 0 var(--space-3);
		font-size: var(--text-sm);
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--color-teal);
	}

	/* ---------- USP band ---------- */
	.usp {
		padding-block: var(--space-8);
	}

	.usp-band {
		max-width: 60ch;
		margin-inline: auto;
		text-align: center;
		padding: var(--space-10) var(--space-8);
		background: var(--glass-bg);
		border: 1px solid var(--glass-border);
		border-radius: var(--radius-xl);
		backdrop-filter: var(--glass-blur);
		-webkit-backdrop-filter: var(--glass-blur);
		box-shadow: var(--shadow-card);
	}

	.usp-band h2 {
		font-size: clamp(1.9rem, 4.5vw, 3rem);
	}

	.usp-body {
		font-size: var(--text-lg);
		color: var(--color-text-muted);
		margin: 0;
	}

	/* ---------- Features grid ---------- */
	.section-title {
		text-align: center;
		font-size: clamp(1.9rem, 4vw, 2.75rem);
		margin-bottom: var(--space-8);
	}

	.features {
		padding-block: var(--space-10);
	}

	.grid {
		display: grid;
		gap: var(--space-5);
		grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
	}

	.card {
		padding: var(--space-6);
		background: var(--glass-bg);
		border: 1px solid var(--glass-border);
		border-radius: var(--radius-lg);
		backdrop-filter: var(--glass-blur);
		-webkit-backdrop-filter: var(--glass-blur);
		transition:
			transform 220ms var(--ease-out),
			border-color 220ms ease,
			box-shadow 220ms ease;
	}

	.card:hover {
		transform: translateY(-4px);
		border-color: rgba(154, 130, 212, 0.45);
		box-shadow: var(--shadow-card);
	}

	.card h3 {
		margin-bottom: var(--space-2);
		color: var(--color-text-primary);
	}

	.card p {
		margin: 0;
	}

	/* ---------- Signup + download ---------- */
	.signup {
		padding-block: var(--space-10);
	}

	.download {
		padding-block: var(--space-12);
	}

	.download-inner {
		display: grid;
		gap: var(--space-8);
		align-items: center;
		padding: var(--space-10) var(--space-8);
		background: var(--glass-bg);
		border: 1px solid var(--glass-border);
		border-radius: var(--radius-xl);
		backdrop-filter: var(--glass-blur);
		-webkit-backdrop-filter: var(--glass-blur);
		box-shadow: var(--shadow-card);
	}

	@media (min-width: 820px) {
		.download-inner {
			grid-template-columns: 1.2fr 0.8fr;
		}
	}

	.download-copy h2 {
		margin: 0 0 var(--space-3);
		font-size: clamp(1.9rem, 4vw, 2.75rem);
	}

	.download-copy p {
		margin: 0 0 var(--space-6);
		font-size: var(--text-lg);
	}

	.download-art .phone {
		width: clamp(200px, 30vw, 300px);
	}

	@media (max-width: 819px) {
		.download-art {
			display: none;
		}
	}
</style>
