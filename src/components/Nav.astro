---
const { pathname } = Astro.url;
const isHome = pathname === '/' || pathname === '';
---

<header class="nav">
	<div class="container nav-inner">
		<a href="/" class="brand" aria-label="Sleepr home">
			<img src="/sleepr-icon.png" alt="" width="36" height="36" />
			<span class="wordmark">Sleepr</span>
		</a>
		<nav aria-label="Primary">
			<ul>
				{isHome ? null : (
					<li><a href="/">Home</a></li>
				)}
				<li><a href="/privacy">Privacy</a></li>
				<li><a href="/terms">Terms</a></li>
			</ul>
		</nav>
	</div>
</header>

<style>
	.nav {
		position: sticky;
		top: 0;
		z-index: 10;
		background: rgba(13, 11, 30, 0.85);
		backdrop-filter: saturate(140%) blur(12px);
		-webkit-backdrop-filter: saturate(140%) blur(12px);
		border-bottom: 1px solid var(--color-border);
	}

	.nav-inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-4);
		padding-block: var(--space-3);
	}

	.brand {
		display: inline-flex;
		align-items: center;
		gap: var(--space-3);
		color: var(--color-text-primary);
		font-weight: 600;
		font-size: var(--text-lg);
		letter-spacing: -0.01em;
	}

	.brand img {
		border-radius: 8px;
	}

	.brand:hover,
	.brand:focus-visible {
		color: var(--color-text-primary);
	}

	.wordmark {
		letter-spacing: -0.02em;
	}

	nav ul {
		display: flex;
		gap: var(--space-5);
		list-style: none;
		margin: 0;
		padding: 0;
	}

	nav a {
		color: var(--color-text-muted);
		font-size: var(--text-sm);
		font-weight: 500;
	}

	nav a:hover,
	nav a:focus-visible {
		color: var(--color-text-primary);
	}

	@media (max-width: 480px) {
		.wordmark {
			display: none;
		}
		nav ul {
			gap: var(--space-4);
		}
	}
</style>
