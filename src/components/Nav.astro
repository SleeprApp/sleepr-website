---
const { pathname } = Astro.url;
const isHome = pathname === '/' || pathname === '';
---

<header class="nav">
	<div class="container nav-inner">
		<a href="/" class="brand" aria-label="Sleepr home">
			<img
				src="/img/sleepr-logo.png"
				alt=""
				width="40"
				height="40"
				class="brand-mark"
			/>
			<span class="wordmark">Sleepr</span>
		</a>
		<nav aria-label="Primary">
			<ul>
				{isHome ? null : (
					<li><a href="/">Home</a></li>
				)}
				<li><a href="/privacy">Privacy</a></li>
				<li><a href="/terms">Terms</a></li>
			</ul>
		</nav>
		<a
			class="nav-cta"
			href="https://apps.apple.com/app/sleepr-ai-sleep-tracker/id6764422192"
			rel="noopener">Get the app</a>
	</div>
</header>

<style>
	.nav {
		position: sticky;
		top: 0;
		z-index: 10;
		background: rgba(13, 11, 30, 0.85);
		backdrop-filter: saturate(140%) blur(12px);
		-webkit-backdrop-filter: saturate(140%) blur(12px);
		border-bottom: 1px solid var(--color-border);
	}

	.nav-inner {
		display: flex;
		align-items: center;
		gap: var(--space-5);
		padding-block: var(--space-3);
	}

	.brand {
		display: inline-flex;
		align-items: center;
		gap: var(--space-2);
		color: var(--color-text-primary);
		font-weight: 600;
		font-size: var(--text-lg);
		letter-spacing: -0.01em;
		margin-right: auto;
	}

	.brand-mark {
		border-radius: 10px;
		filter: drop-shadow(0 4px 12px rgba(124, 107, 173, 0.5));
		transition: transform 240ms var(--ease-spring);
	}

	.brand:hover .brand-mark,
	.brand:focus-visible .brand-mark {
		transform: rotate(-8deg) scale(1.06);
	}

	.brand:hover,
	.brand:focus-visible {
		color: var(--color-text-primary);
	}

	.wordmark {
		letter-spacing: -0.02em;
	}

	nav ul {
		display: flex;
		gap: var(--space-5);
		list-style: none;
		margin: 0;
		padding: 0;
	}

	nav a {
		color: var(--color-text-muted);
		font-size: var(--text-sm);
		font-weight: 500;
		transition: color 160ms ease;
	}

	nav a:hover,
	nav a:focus-visible {
		color: var(--color-text-primary);
	}

	.nav-cta {
		display: inline-flex;
		align-items: center;
		padding: var(--space-2) var(--space-4);
		font-size: var(--text-sm);
		font-weight: 600;
		color: #fff;
		background: linear-gradient(
			135deg,
			var(--color-accent-bright),
			var(--color-accent-deep)
		);
		border-radius: 999px;
		border: 1px solid rgba(255, 255, 255, 0.12);
		box-shadow: var(--shadow-glow);
		transition:
			transform 160ms var(--ease-spring),
			filter 160ms ease,
			color 160ms ease;
	}

	.nav-cta:hover,
	.nav-cta:focus-visible {
		color: #fff;
		transform: translateY(-1px);
		filter: brightness(1.08);
	}

	@media (max-width: 640px) {
		.nav-cta {
			display: none;
		}
	}

	@media (max-width: 480px) {
		.wordmark {
			display: none;
		}
		nav ul {
			gap: var(--space-4);
		}
	}
</style>
