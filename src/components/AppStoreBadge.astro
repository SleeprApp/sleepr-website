---
interface Props {
	href?: string;
	size?: 'md' | 'lg';
}

const {
	href = 'https://apps.apple.com/app/sleepr-ai-sleep-tracker/id6764422192',
	size = 'lg',
} = Astro.props;
---

<a class={`app-store-badge size-${size}`} href={href} rel="noopener">
	<svg
		class="apple-logo"
		viewBox="0 0 24 24"
		aria-hidden="true"
		focusable="false">
		<path
			fill="currentColor"
			d="M17.05 12.04c-.03-2.86 2.34-4.23 2.45-4.3-1.34-1.95-3.42-2.22-4.16-2.25-1.77-.18-3.46 1.04-4.36 1.04-.91 0-2.31-1.02-3.79-.99-1.95.03-3.76 1.13-4.76 2.87-2.03 3.52-.52 8.74 1.46 11.61.97 1.4 2.12 2.97 3.62 2.91 1.45-.06 2-.94 3.74-.94 1.74 0 2.24.94 3.77.91 1.56-.03 2.55-1.42 3.5-2.83 1.1-1.62 1.56-3.19 1.58-3.27-.04-.02-3.03-1.17-3.05-4.64ZM14.4 3.4c.8-.97 1.34-2.32 1.19-3.66-1.15.05-2.55.77-3.38 1.74-.74.86-1.39 2.24-1.22 3.55 1.29.1 2.6-.66 3.41-1.63Z"
		></path>
	</svg>
	<span class="label">
		<span class="small">Download on the</span>
		<span class="big">App Store</span>
	</span>
</a>

<style>
	.app-store-badge {
		display: inline-flex;
		align-items: center;
		gap: 10px;
		background: #000;
		color: #fff;
		border-radius: 10px;
		text-decoration: none;
		border: 1px solid rgba(255, 255, 255, 0.15);
		transition:
			transform 120ms ease,
			background 120ms ease;
		font-family: var(--font-sans);
	}

	.app-store-badge:hover,
	.app-store-badge:focus-visible {
		background: #111;
		color: #fff;
		transform: translateY(-1px);
	}

	.size-md {
		padding: 8px 14px;
	}
	.size-md .apple-logo {
		width: 24px;
		height: 24px;
	}
	.size-md .small {
		font-size: 9px;
	}
	.size-md .big {
		font-size: 17px;
	}

	.size-lg {
		padding: 10px 18px;
	}
	.size-lg .apple-logo {
		width: 30px;
		height: 30px;
	}
	.size-lg .small {
		font-size: 11px;
	}
	.size-lg .big {
		font-size: 21px;
	}

	.label {
		display: inline-flex;
		flex-direction: column;
		line-height: 1.1;
		text-align: left;
	}

	.small {
		font-weight: 400;
		letter-spacing: 0.02em;
		opacity: 0.95;
	}

	.big {
		font-weight: 600;
		letter-spacing: -0.01em;
	}
</style>
